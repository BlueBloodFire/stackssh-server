<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.stackssh.infrastructure.dao.IKnowledgeDocumentDao">

    <resultMap id="KnowledgeDocumentMap" type="cn.stackssh.infrastructure.dao.po.KnowledgeDocumentPO">
        <id column="id" property="id"/>
        <result column="doc_id" property="docId"/>
        <result column="connection_id" property="connectionId"/>
        <result column="agent_id" property="agentId"/>
        <result column="name" property="name"/>
        <result column="file_type" property="fileType"/>
        <result column="status" property="status"/>
        <result column="chunk_count" property="chunkCount"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="cn.stackssh.infrastructure.dao.po.KnowledgeDocumentPO">
        INSERT INTO knowledge_document (doc_id, connection_id, agent_id, name, file_type, status, chunk_count)
        VALUES (#{docId}, #{connectionId}, #{agentId}, #{name}, #{fileType}, #{status}, #{chunkCount})
    </insert>

    <update id="updateStatus">
        UPDATE knowledge_document SET status = #{status}, chunk_count = #{chunkCount}
        WHERE doc_id = #{docId}
    </update>

    <delete id="delete">
        DELETE FROM knowledge_document WHERE doc_id = #{docId}
    </delete>

    <select id="queryByDocId" resultMap="KnowledgeDocumentMap">
        SELECT * FROM knowledge_document WHERE doc_id = #{docId}
    </select>

    <select id="queryList" resultMap="KnowledgeDocumentMap">
        SELECT * FROM knowledge_document
        <where>
            <if test="connectionId != null and connectionId != ''">
                AND connection_id = #{connectionId}
            </if>
            <if test="agentId != null and agentId != ''">
                AND agent_id = #{agentId}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

</mapper>
